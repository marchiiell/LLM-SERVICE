# Скопируйте в .env и заполните ОДИН ключ. Без ключей сервис работает в режиме-заглушке.
# PROVIDER=auto выбирает провайдера по тому, какой ключ задан (порядок: gemini, groq, xai, anthropic).
PROVIDER=auto

# Бесплатные уровни (условия смотрите у провайдеров).
# Ключ Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Ключ Groq: https://console.groq.com/keys
GROQ_API_KEY=

# Платные.
# Ключ xAI (Grok): https://console.x.ai
XAI_API_KEY=
# Ключ Anthropic: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Модель. Пусто = модель по умолчанию (gemini: gemini-3.8-flash, groq: openai/gpt-oss-20b,
# anthropic: claude-sonnet-5-5). Для xai модель нужно указать самому.
MODEL=

MAX_TOKENS=2048

# Сколько секунд ждать ответа модели, прежде чем сдаться
LLM_TIMEOUT=120
SYSTEM_PROMPT=Ты полезный ассистент. Отвечай кратко и по делу.

# RAG: папка для загруженных документов (пусто = хранить только в памяти),
# размер фрагмента в символах, перекрытие фрагментов и максимальный размер файла в МБ
DATA_DIR=data
RAG_CHUNK_SIZE=800
RAG_OVERLAP=100
MAX_UPLOAD_MB=5

# Поиск по смыслу (эмбеддинги Gemini): включается сам, если задан GEMINI_API_KEY.
# EMBEDDINGS=off выключает. Минимальное сходство: чем выше, тем строже отбор фрагментов.
EMBEDDINGS=auto
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
RAG_MIN_SIMILARITY=0.5

# Rate limit: N запросов на клиента за окно в секундах
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# Кэш одинаковых запросов
CACHE_TTL=300
CACHE_MAX_ITEMS=500

# Очередь к модели
MAX_CONCURRENT_LLM=4
QUEUE_TIMEOUT=15

# Если задан, все запросы к /api/chat* должны содержать заголовок X-API-Key с этим значением
SERVICE_API_KEY=
